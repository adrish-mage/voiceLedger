[
  {
    "id": "demo-001",
    "note": "Full demo story: credit, correction, overdue, dispute",
    "customers": [
      {
        "name": "Raju",
        "defaultCreditTermDays": 14
      }
    ],
    "steps": [
      {
        "say": "Raju ko 800 rupaye udhaar likh do, chawal 600 aur tel 200 ka."
      },
      {
        "say": "Haan."
      },
      {
        "newSession": true
      },
      {
        "say": "Raju ka balance kya hai?"
      },
      {
        "say": "Nahi, tel 200 nahi, 120 ka tha."
      },
      {
        "say": "Haan."
      },
      {
        "clockDays": 15
      },
      {
        "say": "Raju bol raha hai usne 300 rupaye de diye the."
      },
      {
        "say": "Haan."
      }
    ],
    "expect": {
      "customer": "Raju",
      "balance": 720,
      "status": "DISPUTED",
      "disputedAmount": 300,
      "eventTypes": [
        "CREDIT_GIVEN",
        "CORRECTION",
        "DISPUTE_OPENED"
      ]
    }
  },
