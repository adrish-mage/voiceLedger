[
  {
    "id": "h-en-partial-payments",
    "note": "Two partial payments",
    "customers": [
      {
        "name": "Amit",
        "defaultCreditTermDays": 14
      }
    ],
    "steps": [
      {
        "say": "Amit took 1000 of rice on credit."
      },
      {
        "say": "Yes."
      },
      {
        "say": "Amit gave me 400 today."
      },
      {
        "say": "Yes."
      },
      {
        "say": "He also paid another 100."
      },
      {
        "say": "Yes."
      }
    ],
    "expect": {
      "customer": "Amit",
      "balance": 500,
      "status": "OUTSTANDING",
      "disputedAmount": 0,
      "eventTypes": [
        "CREDIT_GIVEN",
        "PAYMENT_RECEIVED",
        "PAYMENT_RECEIVED"
      ]
    }
  },
  {
