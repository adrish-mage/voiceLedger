[
  {
    "id": "h2-en-followup-payment",
    "note": "Follow-up payment without naming the customer",
    "customers": [
      {
        "name": "Amit",
        "defaultCreditTermDays": 14
      }
    ],
    "steps": [
      {
        "say": "Amit took 700 of rice on credit."
      },
      {
        "say": "Yes."
      },
      {
        "say": "He paid 200 just now."
      },
      {
        "say": "Yes."
      }
    ],
    "expect": {
      "customer": "Amit",
      "balance": 500,
      "status": "OUTSTANDING",
      "disputedAmount": 0,
      "eventTypes": [
        "CREDIT_GIVEN",
        "PAYMENT_RECEIVED"
      ]
    }
  },
